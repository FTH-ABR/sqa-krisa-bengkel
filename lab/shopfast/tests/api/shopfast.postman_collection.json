{
  "info": {
    "_postman_id": "8b7d2c7e-3f64-4a8e-9d8e-6a1f2b9c4d10",
    "name": "ShopFast API - starter tests",
    "description": "Happy-path starter tests for the ShopFast training system. Run in order: the cart, discount and checkout requests share one X-Session-Id generated by the collection pre-request script.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (!pm.collectionVariables.get('sessionId')) {",
          "    const random = Math.random().toString(36).slice(2, 10);",
          "    pm.collectionVariables.set('sessionId', 'newman-' + Date.now() + '-' + random);",
          "}"
        ]
      }
    }
  ],
  "variable": [
    { "key": "sessionId", "value": "" },
    { "key": "orderId", "value": "" }
  ],
  "item": [
    {
      "name": "01 Health check",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test('service reports ok', function () {",
              "    const body = pm.response.json();",
              "    pm.expect(body.status).to.eql('ok');",
              "    pm.expect(body.version).to.eql('1.0.0');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/health",
          "host": ["{{baseUrl}}"],
          "path": ["api", "health"]
        }
      }
    },
    {
      "name": "02 List products",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test('catalogue has 6 products', function () {",
              "    const body = pm.response.json();",
              "    pm.expect(body).to.be.an('array');",
              "    pm.expect(body.length).to.eql(6);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/products",
          "host": ["{{baseUrl}}"],
          "path": ["api", "products"]
        }
      }
    },
    {
      "name": "03 Add P001 x 2 to cart",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 201', function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "pm.test('subtotal is 179.80', function () {",
              "    const body = pm.response.json();",
              "    pm.expect(body.subtotal).to.eql(179.8);",
              "    pm.expect(body.items[0].productId).to.eql('P001');",
              "    pm.expect(body.items[0].quantity).to.eql(2);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "X-Session-Id", "value": "{{sessionId}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"productId\": \"P001\",\n  \"quantity\": 2\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/cart/items",
          "host": ["{{baseUrl}}"],
          "path": ["api", "cart", "items"]
        }
      }
    },
    {
      "name": "04 Apply RAYA15 promo code",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test('RAYA15 gives 15 percent promo discount', function () {",
              "    const body = pm.response.json();",
              "    pm.expect(body.discountCode).to.eql('RAYA15');",
              "    pm.expect(body.promoDiscount).to.eql(26.97);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "X-Session-Id", "value": "{{sessionId}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"code\": \"RAYA15\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/discounts/apply",
          "host": ["{{baseUrl}}"],
          "path": ["api", "discounts", "apply"]
        }
      }
    },
    {
      "name": "05 Get cart total",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test('total is 160.83 (179.80 less 26.97 promo plus 8.00 shipping)', function () {",
              "    const body = pm.response.json();",
              "    pm.expect(body.total).to.eql(160.83);",
              "    pm.expect(body.shipping).to.eql(8);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          { "key": "X-Session-Id", "value": "{{sessionId}}" }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/cart",
          "host": ["{{baseUrl}}"],
          "path": ["api", "cart"]
        }
      }
    },
    {
      "name": "06 Checkout with valid details",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 201', function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "pm.test('order id starts with SF-', function () {",
              "    const body = pm.response.json();",
              "    pm.expect(body.orderId).to.match(/^SF-/);",
              "    pm.expect(body.status).to.eql('NEW');",
              "    pm.collectionVariables.set('orderId', body.orderId);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "X-Session-Id", "value": "{{sessionId}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"fullName\": \"Aminah binti Ali\",\n  \"email\": \"aminah@example.test\",\n  \"phone\": \"0123456789\",\n  \"postcode\": \"50480\",\n  \"paymentMethod\": \"FPX\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/checkout",
          "host": ["{{baseUrl}}"],
          "path": ["api", "checkout"]
        }
      }
    },
    {
      "name": "07 Reject quantity 0",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 400', function () {",
              "    pm.response.to.have.status(400);",
              "});",
              "pm.test('error code is VALIDATION_ERROR', function () {",
              "    pm.expect(pm.response.json().error).to.eql('VALIDATION_ERROR');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "X-Session-Id", "value": "{{sessionId}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"productId\": \"P001\",\n  \"quantity\": 0\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/cart/items",
          "host": ["{{baseUrl}}"],
          "path": ["api", "cart", "items"]
        }
      }
    },
    {
      "name": "08 Reject unknown discount code",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 422', function () {",
              "    pm.response.to.have.status(422);",
              "});",
              "pm.test('error code is INVALID_CODE', function () {",
              "    pm.expect(pm.response.json().error).to.eql('INVALID_CODE');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "X-Session-Id", "value": "{{sessionId}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"code\": \"TIADAKOD\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/discounts/apply",
          "host": ["{{baseUrl}}"],
          "path": ["api", "discounts", "apply"]
        }
      }
    }
  ]
}
